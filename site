    <!-- LÓGICA JAVASCRIPT COMERCIAL -->
    <script>
        const PHONE_NUMBER = "5527997472027";
        const DELIVERY_FEE = 0.00;

        let cart = [];
        let qtyCoxinha = 2;
        let qtyEnroladinho = 3;

        let drinksQty = {
            coca: 0,
            guarana: 0,
            fanta: 0
        };

        const DRINK_PRICES = {
            coca: 2.00,
            guarana: 2.00,
            fanta: 2.00
        };

        const DRINK_NAMES = {
            coca: "Coca-Cola 150ml",
            guarana: "Guaraná Antarctica 150ml",
            fanta: "Fanta Laranja 150ml"
        };

        function updateMaxQuantity() {
            const sizeSelect = document.getElementById('combo-size');
            const [maxAllowed] = sizeSelect.value.split('|');
            const total = parseInt(maxAllowed);

            qtyCoxinha = Math.floor(total / 2);
            qtyEnroladinho = total - qtyCoxinha;

            document.getElementById('max-allowed').innerText = total;
            document.getElementById('current-total').innerText = total;
            document.getElementById('qty-coxinha').innerText = qtyCoxinha;
            document.getElementById('qty-enroladinho').innerText = qtyEnroladinho;
        }

        function adjustQty(type, change) {
            const sizeSelect = document.getElementById('combo-size');
            const [maxAllowed] = sizeSelect.value.split('|');
            const max = parseInt(maxAllowed);

            if (type === 'coxinha') {
                let newCoxinha = qtyCoxinha + change;
                if (newCoxinha >= 0 && newCoxinha <= max) {
                    qtyCoxinha = newCoxinha;
                    qtyEnroladinho = max - qtyCoxinha;
                }
            } else if (type === 'enroladinho') {
                let newEnroladinho = qtyEnroladinho + change;
                if (newEnroladinho >= 0 && newEnroladinho <= max) {
                    qtyEnroladinho = newEnroladinho;
                    qtyCoxinha = max - qtyEnroladinho;
                }
            }

            document.getElementById('qty-coxinha').innerText = qtyCoxinha;
            document.getElementById('qty-enroladinho').innerText = qtyEnroladinho;
            document.getElementById('current-total').innerText = qtyCoxinha + qtyEnroladinho;
        }

        function adjustDrinkQty(drink, change) {
            const totalSelected = drinksQty.coca + drinksQty.guarana + drinksQty.fanta;

            if (change > 0 && totalSelected >= 3) {
                alert('O limite máximo é de 3 refrigerantes por porção!');
                return;
            }

            if (drinksQty[drink] + change >= 0) {
                drinksQty[drink] += change;
            }

            document.getElementById(`qty-${drink}`).innerText = drinksQty[drink];
            document.getElementById('current-drinks').innerText = drinksQty.coca + drinksQty.guarana + drinksQty.fanta;
        }

        function addComboToCart() {
            const sizeSelect = document.getElementById('combo-size');
            const [maxAllowed, basePriceStr] = sizeSelect.value.split('|');
            const basePrice = parseFloat(basePriceStr);

            let drinksPrice = 0;
            let drinkList = [];

            for (const [key, qty] of Object.entries(drinksQty)) {
                if (qty > 0) {
                    drinksPrice += qty * DRINK_PRICES[key];
                    drinkList.push(`${qty}x ${DRINK_NAMES[key]}`);
                }
            }

            const finalPrice = basePrice + drinksPrice;

            let composition = [];
            if (qtyCoxinha > 0) composition.push(`${qtyCoxinha} Coxinha(s)`);
            if (qtyEnroladinho > 0) composition.push(`${qtyEnroladinho} Enroladinho(s)`);

            const comboItem = {
                id: Date.now(),
                name: `Porção (${maxAllowed} uni)`,
                details: composition.join(' + '),
                drink: drinkList.length > 0 ? drinkList.join(', ') : 'Sem bebida',
                price: finalPrice
            };

            cart.push(comboItem);
            updateCartUI();
            
            // Resetar a contagem de refris do montador após adicionar
            drinksQty = { coca: 0, guarana: 0, fanta: 0 };
            document.getElementById('qty-coca').innerText = 0;
            document.getElementById('qty-guarana').innerText = 0;
            document.getElementById('qty-fanta').innerText = 0;
            document.getElementById('current-drinks').innerText = 0;

            alert(`✅ Item adicionado ao carrinho!`);
        }

        function showSection(sectionName) {
            const menuSection = document.getElementById('section-menu');
            const instSection = document.getElementById('section-institutional');
            const btnMenu = document.getElementById('btn-menu');
            const btnInst = document.getElementById('btn-institutional');

            if (sectionName === 'menu') {
                menuSection.classList.remove('hidden');
                instSection.classList.add('hidden');
                btnMenu.classList.add('bg-brand-yellow', 'text-brand-red');
                btnInst.classList.remove('bg-brand-yellow', 'text-brand-red');
            } else {
                menuSection.classList.add('hidden');
                instSection.classList.remove('hidden');
                btnInst.classList.add('bg-brand-yellow', 'text-brand-red');
                btnMenu.classList.remove('bg-brand-yellow', 'text-brand-red');
            }
        }

        function toggleDeliveryOptions() {
            const type = document.getElementById('delivery-type').value;
            const addressFields = document.getElementById('address-fields');
            if (type === 'Retirada') {
                addressFields.classList.add('hidden');
            } else {
                addressFields.classList.remove('hidden');
            }
            updateCartUI();
        }

        function updateCartUI() {
            const cartCount = document.getElementById('cart-count');
            const cartContainer = document.getElementById('cart-items-container');
            const formContainer = document.getElementById('checkout-form-container');
            const cartSubtotal = document.getElementById('cart-subtotal');
            const cartDeliveryFee = document.getElementById('cart-delivery-fee');
            const cartTotal = document.getElementById('cart-total');

            cartCount.innerText = cart.length;

            if (cart.length === 0) {
                cartContainer.innerHTML = '<p class="text-center text-gray-500 py-8">Seu carrinho está vazio.</p>';
                formContainer.classList.add('hidden');
                cartSubtotal.innerText = 'R$ 0,00';
                cartDeliveryFee.innerText = 'R$ 0,00';
                cartTotal.innerText = 'R$ 0,00';
                return;
            }

            formContainer.classList.remove('hidden');

            let html = '';
            let subtotal = 0;

            cart.forEach((item, index) => {
                subtotal += item.price;
                html += `
                    <div class="bg-gray-50 p-4 rounded-2xl border border-gray-200 flex justify-between items-center">
                        <div>
                            <h4 class="font-bold text-gray-800 text-sm">${item.name}</h4>
                            <p class="text-xs text-brand-orange font-semibold">${item.details}</p>
                            <p class="text-xs text-gray-500">Bebidas: ${item.drink}</p>
                            <span class="text-xs font-bold text-gray-700 mt-1 block">R$ ${item.price.toFixed(2).replace('.', ',')}</span>
                        </div>
                        <button onclick="removeFromCart(${index})" class="text-red-500 hover:text-red-700 p-2 text-sm">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </div>
                `;
            });

            const deliveryType = document.getElementById('delivery-type').value;
            const currentFee = deliveryType === 'Entrega' ? DELIVERY_FEE : 0.00;
            const total = subtotal + currentFee;

            cartContainer.innerHTML = html;
            cartSubtotal.innerText = `R$ ${subtotal.toFixed(2).replace('.', ',')}`;
            cartDeliveryFee.innerText = `R$ ${currentFee.toFixed(2).replace('.', ',')}`;
            cartTotal.innerText = `R$ ${total.toFixed(2).replace('.', ',')}`;
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            updateCartUI();
        }

        function clearCart() {
            cart = [];
            updateCartUI();
        }

        function toggleCartModal() {
            document.getElementById('cart-modal').classList.toggle('hidden');
        }

        function checkoutWhatsApp() {
            if (cart.length === 0) {
                alert('Adicione itens ao carrinho antes de finalizar!');
                return;
            }

            const name = document.getElementById('cust-name').value.trim();
            const deliveryType = document.getElementById('delivery-type').value;
            const paymentMethod = document.getElementById('payment-method').value;
            const address = document.getElementById('cust-address').value.trim();
            const obs = document.getElementById('cust-obs').value.trim();

            if (!name) {
                alert('Por favor, informe seu nome!');
                return;
            }

            if (deliveryType === 'Entrega' && !address) {
                alert('Por favor, informe o endereço de entrega!');
                return;
            }

            let text = `*--- NOVO PEDIDO: DJ COXINHA ---*\n\n`;
            text += `*Cliente:* ${name}\n`;
            text += `*Tipo:* ${deliveryType}\n`;
            if (deliveryType === 'Entrega') {
                text += `*Endereço:* ${address}\n`;
            }
            if (obs) text += `*Obs:* ${obs}\n`;
            text += `*Pagamento:* ${paymentMethod}\n\n`;

            text += `*ITENS DO PEDIDO:*\n`;
            let subtotal = 0;
            cart.forEach((item, i) => {
                subtotal += item.price;
                text += `\n${i+1}. *${item.name}*\n`;
                text += `   • Divisão: ${item.details}\n`;
                text += `   • Bebida(s): ${item.drink}\n`;
                text += `   • Valor: R$ ${item.price.toFixed(2).replace('.', ',')}\n`;
            });

            const currentFee = deliveryType === 'Entrega' ? DELIVERY_FEE : 0.00;
            const total = subtotal + currentFee;

            text += `\n----------------------------\n`;
            text += `*Subtotal:* R$ ${subtotal.toFixed(2).replace('.', ',')}\n`;
            text += `*Taxa Entrega:* R$ ${currentFee.toFixed(2).replace('.', ',')}\n`;
            text += `*TOTAL:* *R$ ${total.toFixed(2).replace('.', ',')}*`;

            const encodedText = encodeURIComponent(text);
            const whatsappUrl = `https://wa.me/${PHONE_NUMBER}?text=${encodedText}`;

            window.open(whatsappUrl, '_blank');
        }
    </script>
</body>
